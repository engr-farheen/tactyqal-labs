  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "type": "module",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^6.0.3"
  }
}