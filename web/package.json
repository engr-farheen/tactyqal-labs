{
  "name": "tactyqal-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "images:hd": "node scripts/fetch-hd-images.mjs",
    "test": "node --test test/tools.test.mjs",
    "lint": "eslint src test scripts e2e playwright.config.js",
